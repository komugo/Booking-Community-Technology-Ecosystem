    "@komugo/db": "workspace:*",
    "@komugo/types": "workspace:*",
    "astro": "7.4.2",
    "drizzle-orm": "0.45.4",
    "uqr": "0.1.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.153.0"
  }
