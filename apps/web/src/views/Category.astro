---
import Base from "../layouts/Base.astro";
import HubHero from "../components/HubHero.astro";
import CategoryTile from "../components/CategoryTile.astro";
import ActivityCard from "../components/ActivityCard.astro";
import { path, t } from "../lib/i18n";
import { heroSizes } from "../lib/photo";
import { breadcrumbLd, itemListLd } from "../lib/seo";
import type { CategoryData } from "../lib/catalog";

type Props = CategoryData;
const { locale, alternates, city, category, activities, otherCategories, indexable } = Astro.props;
const s = t[locale];
const crumbs = [
  { name: s.home, path: path(locale) },
  { name: city.name, path: path(locale, city.slugs[locale]) },
  { name: category.name, path: alternates[locale] },
];
---

<Base
  locale={locale}
  title={s.categoryTitle(category.name, city.name)}
  description={s.categoryDescription(category.name, city.name)}
  alternates={alternates}
  indexable={indexable}
  image={category.photo}
  hero={category.photo ? { photo: category.photo, sizes: heroSizes(category.photo) } : undefined}
  jsonLd={[breadcrumbLd(Astro.site, crumbs), ...itemListLd(Astro.site, locale, activities)]}
>
  <HubHero locale={locale} photo={category.photo} lines={s.categoryHeadline(category.name, city.name)} crumbs={crumbs} />

  <div class="wrap">
    <p class="mt-10 max-w-2xl text-xl leading-relaxed md:mt-16 md:text-2xl">{category.intro}</p>

    {
      activities.length ? (
        <>
        <h2 class="sr-only">{s.allActivities}</h2>
        <div class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {activities.map((a) => <ActivityCard card={a} locale={locale} sizes="(min-width: 1024px) 24rem, (min-width: 640px) 50vw, 100vw" />)}
        </div>
        </>
      ) : (
        <p class="mt-10 text-muted">{s.empty}</p>
      )
    }

    {
      otherCategories.length > 0 && (
        <section class="mt-24" aria-labelledby="other">
          <h2 id="other" class="text-4xl font-extrabold md:text-6xl">{s.alsoIn(city.name)}</h2>
          <div class="mt-8 grid grid-cols-2 gap-3 md:gap-6">
            {otherCategories.map((c) => (
              <CategoryTile hub={c} href={path(locale, city.slugs[locale], c.slugs[locale])} locale={locale} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>
