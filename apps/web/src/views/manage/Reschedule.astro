---
import Checkout from "../../layouts/Checkout.astro";
import BottomBar from "../../components/checkout/BottomBar.astro";
import DateStrip from "../../components/checkout/DateStrip.astro";
import { klDay, klDeadline, klLongDay, klTime, t } from "../../lib/i18n";
import { groupHref, type rescheduleStep } from "../../lib/manage";

type Props = Exclude<Awaited<ReturnType<typeof rescheduleStep>>, Response>;
const { locale: l, g, t: which, tickets, blocked, days, date, times, nextOpen, selected, requestId, problems: p } = Astro.props;
const s = t[l];
const m = s.manage;
const c = s.checkout;
const back = groupHref(l, g);
const here = Astro.url.pathname;
const dayLink = (d: string) => `${here}?t=${encodeURIComponent(which)}&k=${g.k}&date=${d}`;
const names = new Intl.ListFormat(l === "ms" ? "ms-MY" : "en-MY", { type: "conjunction" }).format(tickets.map((x) => x.participantName));
---

<Checkout locale={l} title={tickets.length ? m.moveTitle(names) : m.changeTime} back={back} problems={p}>
  {
    blocked ? (
      <a href={back} class="mt-6 inline-flex min-h-12 items-center rounded-full bg-leaf px-6 font-semibold text-white hover:bg-forest">{m.keep}</a>
    ) : (
      <>
        <p class="mt-3 text-lg">{m.moveSub}</p>
        <p class="mt-4 rounded-2xl bg-white p-4 shadow-[0_1px_0_var(--color-line)]">
          <span class="block text-sm text-muted">{m.current}</span>
          <span class="font-semibold">{klLongDay(l, tickets[0].startsAt)} · <span class="num">{klTime(l, tickets[0].startsAt)}</span></span>
        </p>
        <form method="post" class="mt-8 space-y-8" data-move>
          <input type="hidden" name="requestId" value={requestId} />
          <input type="hidden" name="t" value={which} />
          <input type="hidden" name="date" value={date} />
          <DateStrip locale={l} days={days} date={date} href={dayLink} />
          <fieldset id="time" class="min-w-0">
            <legend class="text-xl font-bold">{c.time} <span class="font-normal text-muted">· {klDay(l, Date.parse(`${date}T04:00:00Z`))}</span></legend>
            {
              times.length ? (
                <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
                  {times.map((x) => (
                    <label class="flex min-h-14 cursor-pointer items-center justify-center rounded-2xl border border-line bg-white px-3 py-2 has-checked:border-forest has-checked:bg-forest has-checked:text-white has-focus-visible:outline-3 has-focus-visible:outline-lime">
                      <input type="radio" name="timeslotId" value={x.id} checked={x.id === selected?.id} data-label={m.moveTo(klDeadline(l, x.startsAt))} class="sr-only" />
                      <span class="num font-semibold">{klTime(l, x.startsAt)}</span>
                    </label>
                  ))}
                </div>
              ) : (
                <div class="mt-3 rounded-2xl bg-sand p-4">
                  <p class="font-semibold">{c.noTimes}</p>
                  {nextOpen ? (
                    <a href={dayLink(nextOpen.date)} class="mt-2 inline-flex min-h-12 items-center font-semibold text-leaf underline underline-offset-2">
                      {c.nextFree}: {klDay(l, nextOpen.at)}
                    </a>
                  ) : (
                    <p class="mt-1 text-sm">{m.noSlots}</p>
                  )}
                </div>
              )
            }
          </fieldset>
          <BottomBar locale={l} label="" sen={null}>
            <button data-submit class="ml-auto inline-flex min-h-12 shrink items-center rounded-full bg-leaf px-6 text-left leading-tight font-semibold text-white hover:bg-forest disabled:opacity-50" disabled={!selected}>
              {selected ? m.moveTo(klDeadline(l, selected.startsAt)) : m.move}
            </button>
          </BottomBar>
        </form>
      </>
    )
  }
</Checkout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-move]");
  form?.addEventListener("change", () => {
    const x = form.querySelector<HTMLInputElement>("input[name=timeslotId]:checked");
    if (x) form.querySelector("[data-submit]")!.textContent = x.dataset.label!;
  });
</script>
