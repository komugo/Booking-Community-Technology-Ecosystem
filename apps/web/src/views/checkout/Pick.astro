---
import Checkout from "../../layouts/Checkout.astro";
import BottomBar from "../../components/checkout/BottomBar.astro";
import FieldError from "../../components/checkout/FieldError.astro";
import Stepper from "../../components/checkout/Stepper.astro";
import DateStrip from "../../components/checkout/DateStrip.astro";
import { duration, klDay, klTime, path, requirements, rm, t } from "../../lib/i18n";
import type { pickStep } from "../../lib/checkout";

type Props = Exclude<Awaited<ReturnType<typeof pickStep>>, Response>;
const { locale: l, option: o, activityName, siblings, addOns, days, date, times, nextOpen, values, min, max, problems: p } = Astro.props;
const s = t[l];
const c = s.checkout;
const here = path(l, "book", o.id);
const name = l === "ms" ? o.nameMs : o.nameEn;
const total = o.priceSen * values.quantity + addOns.reduce((sum, a) => sum + (values.addOns[a.id] ?? 0) * a.priceSen, 0);
const carried = new URLSearchParams({
  quantity: String(values.quantity),
  ...Object.fromEntries(Object.entries(values.addOns).filter(([, n]) => n > 0).map(([id, n]) => [`addOn.${id}`, String(n)])),
});
const dayLink = (d: string) => `${here}?date=${d}&${carried}`;
const picked = times.find((x) => x.id === values.timeslotId);
---

<Checkout locale={l} title={c.pickTitle} step={1} problems={p}>
  <form method="post" action={here} data-pick={o.priceSen} class="mt-6 space-y-8" novalidate>
    <input type="hidden" name="date" value={date} />
    <section class="rounded-2xl bg-white p-4 shadow-[0_1px_0_var(--color-line)]">
      <p class="text-sm text-muted">{activityName}</p>
      <p class="mt-1 text-xl font-bold">{name}</p>
      <p class="mt-1 text-sm">{[duration(l, o.durationMinutes), ...requirements(l, o)].join(" · ")}</p>
      {
        siblings.length > 1 && (
          <ul class="mt-3 flex flex-wrap gap-2" aria-label={s.options}>
            {siblings.map((x) => (
              <li>
                <a
                  href={path(l, "book", x.id)}
                  aria-current={x.id === o.id ? "page" : undefined}
                  class:list={[
                    "inline-flex min-h-12 items-center rounded-full border px-4 text-sm font-semibold",
                    x.id === o.id ? "border-forest bg-forest text-white" : "border-line bg-paper hover:border-leaf",
                  ]}
                >
                  {l === "ms" ? x.nameMs : x.nameEn} · {rm(x.priceSen)}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <DateStrip locale={l} days={days} date={date} href={dayLink} />

    <fieldset id="time" class="min-w-0">
      <legend class="text-xl font-bold">{c.time} <span class="font-normal text-muted">· {klDay(l, Date.parse(`${date}T04:00:00Z`))}</span></legend>
      <FieldError p={p} id="time" />
      {
        times.length ? (
          <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
            {times.map((x) => (
              <label class="relative flex min-h-14 cursor-pointer flex-col items-center justify-center rounded-2xl border border-line bg-white px-3 py-2 has-checked:border-forest has-checked:bg-forest has-checked:text-white has-focus-visible:outline-3 has-focus-visible:outline-lime">
                <input type="radio" name="timeslotId" value={x.id} checked={x.id === values.timeslotId} data-spots={x.spots} data-low-text={c.onlyLeft(x.spots)} class="sr-only" />
                <span class="num font-semibold">{klTime(l, x.startsAt)}</span>
                {x.spots <= 3 && <span class="text-xs">{c.left(x.spots)}</span>}
              </label>
            ))}
          </div>
        ) : (
          <div class="mt-3 rounded-2xl bg-sand p-4">
            <p class="font-semibold">{c.noTimes}</p>
            {nextOpen ? (
              <a data-day href={dayLink(nextOpen.date)} class="mt-2 inline-flex min-h-12 items-center font-semibold text-leaf underline underline-offset-2">
                {c.nextFree}: {klDay(l, nextOpen.at)}
              </a>
            ) : (
              <p class="mt-1 text-sm">{c.noDates}</p>
            )}
          </div>
        )
      }
    </fieldset>

    <section aria-labelledby="people-label">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h2 id="people-label" class="text-xl font-bold">{c.people}</h2>
          <p class="text-sm text-muted">{rm(o.priceSen)} {c.each}{min > 1 && <> · {s.group(min)}</>}</p>
        </div>
        <Stepper id="quantity" name="quantity" label={c.people} value={values.quantity} min={min} max={max} fewer={c.fewer(c.people)} more={c.more(c.people)} />
      </div>
      <FieldError p={p} id="quantity" />
      <p data-low hidden={!picked || picked.spots > 3} class="mt-2 text-sm font-medium text-clay">{c.onlyLeft(picked?.spots ?? 0)}</p>
    </section>

    {
      addOns.length > 0 && (
        <section id="addOns" aria-labelledby="addons-label">
          <h2 id="addons-label" class="text-xl font-bold">{s.addOns}</h2>
          <FieldError p={p} id="addOns" />
          <ul class="mt-2 divide-y divide-line">
            {addOns.map((a) => {
              const an = l === "ms" ? a.nameMs : a.nameEn;
              return (
                <li class="flex items-center justify-between gap-4 py-3">
                  <p>
                    {an}
                    <span class="num block text-sm text-muted">{rm(a.priceSen)} {c.each}</span>
                  </p>
                  <Stepper
                    id={`addOn-${a.id}`}
                    name={`addOn.${a.id}`}
                    label={an}
                    value={values.addOns[a.id] ?? 0}
                    min={0}
                    max={values.quantity}
                    fewer={c.fewer(an)}
                    more={c.more(an)}
                    attrs={{ "data-addon": a.priceSen }}
                  />
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    <BottomBar locale={l} label={c.estimated} sen={total}>
      <button class="inline-flex min-h-12 shrink-0 items-center rounded-full bg-leaf px-6 font-semibold text-white hover:bg-forest disabled:opacity-50" disabled={!times.length}>
        {c.continue}
      </button>
    </BottomBar>
  </form>
</Checkout>
