---
import Checkout from "../../layouts/Checkout.astro";
import Notices from "../../components/manage/Notices.astro";
import Visit from "../../components/manage/Visit.astro";
import Where from "../../components/manage/Where.astro";
import { rm, t } from "../../lib/i18n";
import { named } from "../../lib/checkout";
import type { groupStep } from "../../lib/manage";
import type { Booking } from "../../lib/api";

type Props = Exclude<Awaited<ReturnType<typeof groupStep>>, Response> & { g: Booking };
const { locale: l, g: b, visits, closures, cancelled, moved } = Astro.props;
const s = t[l];
const c = s.checkout;
const live = b.tickets.some((x) => x.status === "issued" && x.closedAt === null);
---

<Checkout locale={l} title={live ? c.bookedTitle : s.manage.yourBooking}>
  <p class="mt-2 text-lg">{named(b.activity, l)} · {named(b.option, l)}</p>
  <Notices locale={l} g={b} closures={closures} cancelled={cancelled} moved={moved} />
  {
    live && (
      <>
        <p class="mt-3 text-sm text-muted">{c.emailCopy}</p>
        <p class="mt-4 rounded-xl bg-lime/30 px-3 py-3 text-sm font-semibold text-forest">{c.brightness}</p>
      </>
    )
  }

  {visits.map((v) => <Visit locale={l} g={b} visit={v} />)}

  {
    b.addOns.length > 0 && (
      <section class="mt-8 rounded-2xl bg-white p-4" aria-labelledby="addons">
        <h2 id="addons" class="text-xl font-bold">{s.addOns}</h2>
        <ul class="mt-2 space-y-1 text-sm">
          {b.addOns.map((x) => (
            <li class="flex justify-between gap-4"><span>{named(x, l)} × {x.quantity}</span><span class="num">{rm(x.priceSen * x.quantity)}</span></li>
          ))}
        </ul>
      </section>
    )
  }

  <Where locale={l} activity={b.activity} />

  <section class="mt-4 rounded-2xl bg-sand p-4 text-sm">
    <p class="flex justify-between"><span>{c.paid}</span><span class="num font-semibold">{rm(b.amountSen)}</span></p>
    {b.freeCancelHours !== null && <p class="mt-2">{s.cancelText(b.freeCancelHours)}</p>}
  </section>
</Checkout>
