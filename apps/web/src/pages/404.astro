---
import Base from "../layouts/Base.astro";
import { path, t } from "../lib/i18n";

const locale = Astro.url.pathname === "/ms" || Astro.url.pathname.startsWith("/ms/") ? "ms" : "en";
const s = t[locale];
---

<Base locale={locale} title={`${s.notFoundTitle} | Komugo`} description={s.notFoundBody} alternates={{ en: path("en"), ms: path("ms") }} indexable={false} canonical={false} image={null}>
  <section class="bg-forest pt-32 pb-20 text-white">
    <div class="wrap">
      <h1 class="text-[clamp(3rem,12vw,7.5rem)] font-extrabold leading-[0.88]">{s.notFoundTitle}</h1>
      <p class="mt-6 max-w-md text-lg text-white/85">{s.notFoundBody}</p>
      <a href={path(locale)} class="mt-8 inline-flex min-h-12 items-center rounded-full bg-lime px-6 font-semibold text-ink">{s.backHome}</a>
    </div>
  </section>
</Base>
