---
import type { ActivityCard, Locale } from "@komugo/db";
import Photo from "./Photo.astro";
import Price from "./Price.astro";
import { durationRange, t } from "../lib/i18n";
import { cardPath } from "../lib/seo";

interface Props {
  card: ActivityCard;
  locale: Locale;
  sizes: string;
  badge?: boolean;
}
const { card, locale, sizes, badge = false } = Astro.props;
const s = t[locale];
const length = durationRange(locale, card.minDurationMinutes, card.maxDurationMinutes);
const age = card.minAge !== null ? s.age(card.minAge, null) : null;
---

<article class="group relative flex flex-col">
  {card.photo && <Photo photo={card.photo} locale={locale} sizes={sizes} transition={`act-${card.id}`} class="aspect-4/5 rounded-3xl" />}
  <div class="pt-4">
    <p class="text-sm font-medium text-leaf">{card.category.name}</p>
    <h3 class="mt-1 text-2xl font-bold">
      <a href={cardPath(locale, card)} class="stretch underline-offset-4 group-hover:underline">{card.name}</a>
    </h3>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
      {badge && card.listingMode === "bookable" && <span data-badge class="rounded-full bg-leaf px-3 py-1 font-semibold text-white">{s.bookNow}</span>}
      {badge && card.listingMode === "info" && <span data-badge class="rounded-full bg-sand px-3 py-1 font-semibold text-forest">{s.infoBadge}</span>}
      {
        card.fromPriceSen !== null && (
          <span class="rounded-full bg-lime px-3 py-1 text-ink">
            <Price locale={locale} sen={card.fromPriceSen} confirmed from />
          </span>
        )
      }
      {card.fromPriceSen !== null && card.listingMode !== "bookable" && <span class="text-xs font-medium text-clay">{s.unconfirmed}</span>}
      {length && <span class="rounded-full border border-line px-3 py-1 text-muted">{length}</span>}
      {age && <span class="rounded-full border border-line px-3 py-1 text-muted">{age}</span>}
    </div>
  </div>
</article>
