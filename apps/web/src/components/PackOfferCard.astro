---
import type { Locale } from "@komugo/db";
import { path, rm, t } from "../lib/i18n";
import type { ActivityData } from "../lib/catalog";

interface Props {
  offer: ActivityData["packOffers"][number];
  locale: Locale;
}
const { offer: o, locale: l } = Astro.props;
const p = t[l].packs;
---

<li id={`pack-${o.id}`} class="reveal scroll-mt-24 rounded-2xl bg-forest p-5 text-white shadow-[0_8px_24px_-12px_rgb(14_26_20/0.4)]">
  <h3 class="text-xl font-bold">{o.name}</h3>
  <p class="num mt-2 text-2xl font-semibold text-lime">{p.sessions(o.sessions)} · {rm(o.priceSen)}</p>
  <p class="num text-sm text-white/80">{p.perSession(rm(Math.round(o.priceSen / o.sessions)))}</p>
  <ul class="mt-3 flex flex-wrap gap-1.5 text-sm">
    {o.options.length > 0 && <li class="rounded-full bg-white/15 px-2.5 py-0.5">{p.for(o.options.join(", "))}</li>}
    <li class="num rounded-full bg-white/15 px-2.5 py-0.5">{p.within(o.validDays)}</li>
  </ul>
  <p class="mt-3 text-sm text-white/80">{p.rule}</p>
  <a href={path(l, "packs", "buy", o.id)} class="mt-4 inline-flex min-h-11 items-center rounded-full bg-lime px-5 font-semibold text-ink hover:bg-white">{p.buy}<span class="sr-only">: {o.name}</span></a>
</li>
