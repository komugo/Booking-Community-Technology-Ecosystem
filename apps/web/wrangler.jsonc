{
  "name": "komugo-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist" },
  "routes": [
    { "pattern": "komugo.com", "custom_domain": true },
    { "pattern": "www.komugo.com", "custom_domain": true }
  ],
  "vars": { "SHOW_DRAFTS": "false" },
  "services": [{ "binding": "API", "service": "komugo-api" }],
  "d1_databases": [{ "binding": "DB", "database_name": "komugo", "database_id": "b90adae4-af83-4a00-b3ad-f6856f569715" }],
  "env": {
    "staging": {
      "routes": [],
      "workers_dev": true,
      "vars": { "SHOW_DRAFTS": "true" },
      "services": [{ "binding": "API", "service": "komugo-api-staging" }],
      "d1_databases": [{ "binding": "DB", "database_name": "komugo-staging", "database_id": "e63e7ad5-aeff-4434-be41-cd5e2fa2ca6b" }]
    }
  }
}
