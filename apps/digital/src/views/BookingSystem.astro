---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PackageCard from "../components/PackageCard.astro";
import Shot from "../components/Shot.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { hostingCovers, hostingSentence, careNote } from "../content/care";
import { company } from "../content/company";
import { href, rm, t, type Locale } from "../content/i18n";
import { pkg } from "../content/packages";
import { packageLd } from "../lib/seo";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t[locale];
const p = pkg("booking");
const fee = rm(locale, p.fee);
const hosting = `${rm(locale, p.hosting!)}${s.perYear}`;
const quote = `${href(locale, "/contact")}?package=${p.id}`;

const copy = {
  en: {
    title: "Booking system for courts, venues and events",
    description: `Your own booking system, custom-built on the engine behind Komugo Platform: real-time availability, CHIP payments, automatic refunds. ${fee}.`,
    crumb: "Booking system",
    h1: "A booking system on an engine that's already built.",
    lede: "Your own booking site, custom-built for your rules on our proven booking engine. It's the same engine that runs Komugo Platform in Putrajaya, so courts, tickets, payments and refunds are already built before we start on yours.",
    feeLabel: "Development",
    hostingLabel: "Hosting and technical support",
    deliveryLabel: "Delivery",
    live: "See it live at komugo.com",
    shotAlt: "Komugo Platform activity page for badminton in Putrajaya, with opening hours and a How to book button",
    shotCaption: "Komugo Platform, running on the engine your Booking system is built on.",
    engine: ["The engine", "What's already built.", "Every feature below is built into the engine behind komugo.com. We configure and extend it for you rather than writing it again."],
    features: [
      ["Real-time availability", "Courts, instructors and lanes are tracked as resources. A time shows as open only when everything it needs is free, so the same court is never sold twice."],
      ["Timeslots and schedules", "Set start times once as a weekly pattern, with peak-hour prices, closed days and a booking cutoff. Add one-off slots when you need them."],
      ["Per court or per person", "Hire a whole court for back-to-back hours on one ticket in the customer's name, or sell named tickets one person at a time."],
      ["Date tickets", "Day entry for a pool, gym or rink: valid any time on the chosen date, with an optional daily limit and weekend or public holiday prices."],
      ["Packs", "Prepaid bundles of sessions with an expiry date. Customers redeem a session at checkout, and a cancelled session goes back into the pack."],
      ["Event ticketing", "Fixed-date events with tiers like early bird and VIP, passes for every day, free tickets and a cap per tier. Gate staff check guests in from the day list."],
      ["Holds at checkout", "The slot is held while the customer pays. Nobody else can take it mid-payment, and it's released if they leave."],
      ["CHIP payments, automatic refunds", "CHIP payments and automatic refunds are built in. Refunds go back to the customer's original payment method automatically; anything CHIP can't return is listed for your team to settle."],
      ["Cancellations and reschedules", "Set a free-cancel window per activity. Customers cancel or move their own booking inside it and see the outcome before they confirm."],
      ["Closures", "Rain or maintenance? Close a slot or a whole day. Each affected customer is emailed once to choose a refund or a new time."],
      ["WhatsApp alerts and day list", "Your counter gets a WhatsApp message for every booking, cancellation and reschedule, linking to that day's live list of tickets. No sign-in needed."],
      ["English and Bahasa Malaysia", "Customer pages and emails in both languages. Staff alerts go out in the language each contact prefers."],
    ],
    custom: ["Your rules", "Custom-built around how you run.", "No two venues work the same way. Before we build, we write down your rules and set the engine to them."],
    customItems: [
      ["Booking rules", "Cancellation windows, booking cutoffs, how many bookings one customer can hold, and who can book what."],
      ["Venues and resources", "Courts, rooms, lanes and instructors, each with its own opening hours and closed days."],
      ["Prices", "Peak and off-peak hours, weekend and public holiday rates, packs and event tiers."],
      ["Brand and domain", "Your own site on your own domain, with your logo, colours and copy in BM and English."],
      ["Team and roles", "Separate access for owners, counter staff and admins."],
      ["Integrations", "Accounting, membership or systems you already use. Each one is scoped and quoted."],
    ],
    packageSection: ["Package", "One Package, priced by your rules."],
    hostingTitle: "Hosting covers",
    hostingFrom: `${hosting}. Paid yearly from launch.`,
    pricing: "Care plans and Add-on services",
    proof: ["Proof", "See it at komugo.com.", "Komugo Platform is our own booking marketplace for activities in Putrajaya. It's soft-launched and built on the engine described above. Open it and pick a court to see the flow your customers would get."],
    visit: "Visit komugo.com",
    caseStudy: "Read the case study",
    faqLabel: "Questions",
    faqTitle: "About the Booking system.",
    faq: [
      ["Is it built from scratch?", `No. It's custom-built for your rules on our proven booking engine, the one that runs Komugo Platform. That's why it takes ${p.delivery.en}, not a year.`],
      ["Do we get our own site, or a listing on komugo.com?", "Your own site on your own domain, with your branding and your own admin dashboard. It isn't a listing on komugo.com."],
      ["What decides the final price?", `The fee is ${fee}. ${p.priceNote!.en}`],
      ["Can we use a payment gateway other than CHIP?", "The engine takes payments and sends refunds through CHIP. Another gateway is possible; we scope it as an integration and it's reflected in the quote."],
      ["What does Hosting and technical support cover?", `${hostingSentence("en")}. ${hosting}. ${careNote.en}`],
      ["Who is it for?", `${p.bestFor.en.join(", ")}. If people book a time, a place or a ticket from you, it fits.`],
    ],
  },
  ms: {
    title: "Sistem tempahan online untuk gelanggang, dewan dan acara",
    description: `Sistem tempahan anda sendiri, dibina khas di atas enjin Komugo Platform: kekosongan masa nyata, bayaran CHIP, bayaran balik automatik. ${fee}.`,
    crumb: "Sistem tempahan",
    h1: "Sistem tempahan di atas enjin yang sudah siap dibina.",
    lede: "Laman tempahan anda sendiri, dibina khas mengikut peraturan anda di atas enjin tempahan kami yang telah terbukti. Enjin yang sama menggerakkan Komugo Platform di Putrajaya, jadi gelanggang, tiket, bayaran dan bayaran balik sudah siap dibina sebelum kami mula membina laman anda.",
    feeLabel: "Pembangunan",
    hostingLabel: "Hosting dan sokongan teknikal",
    deliveryLabel: "Tempoh siap",
    live: "Lihat sendiri di komugo.com",
    shotAlt: "Halaman aktiviti badminton Komugo Platform di Putrajaya, dengan waktu operasi dan butang How to book",
    shotCaption: "Komugo Platform, dibina di atas enjin yang sama untuk Sistem tempahan anda.",
    engine: ["Enjin", "Apa yang sudah dibina.", "Setiap ciri di bawah sudah dibina dalam enjin di sebalik komugo.com. Kami tetapkan dan kembangkannya untuk anda, bukan menulisnya semula."],
    features: [
      ["Kekosongan masa nyata", "Gelanggang, jurulatih dan lorong dijejak sebagai sumber. Sesuatu masa hanya dibuka jika semua yang diperlukan masih kosong, jadi gelanggang yang sama tidak akan dijual dua kali."],
      ["Slot masa dan jadual", "Tetapkan masa mula sekali sahaja sebagai corak mingguan, dengan harga waktu puncak, hari tutup dan had masa tempahan. Tambah slot sekali sahaja bila perlu."],
      ["Ikut gelanggang atau ikut orang", "Sewa satu gelanggang untuk beberapa jam berturut-turut dengan satu tiket atas nama pelanggan, atau jual tiket bernama seorang demi seorang."],
      ["Tiket harian", "Masuk sehari untuk kolam, gim atau gelanggang ais: sah pada bila-bila masa pada tarikh dipilih, dengan had harian pilihan dan harga hujung minggu atau cuti umum."],
      ["Pek sesi", "Pek sesi prabayar dengan tarikh luput. Pelanggan tebus satu sesi semasa pembayaran, dan sesi yang dibatalkan kembali ke dalam pek."],
      ["Tiket acara", "Acara bertarikh tetap dengan kategori seperti early bird dan VIP, pas untuk semua hari, tiket percuma dan had bagi setiap kategori. Petugas pintu daftar masuk tetamu dari senarai harian."],
      ["Slot dikunci semasa bayar", "Slot dipegang selagi pelanggan membuat bayaran. Orang lain tidak boleh mengambilnya di tengah jalan, dan ia dilepaskan jika pelanggan beredar."],
      ["Bayaran CHIP, bayaran balik automatik", "Bayaran CHIP dan bayaran balik automatik sudah tersedia. Bayaran balik dihantar terus ke kaedah bayaran asal pelanggan secara automatik; yang tidak dapat dipulangkan oleh CHIP disenaraikan untuk diselesaikan oleh pasukan anda."],
      ["Pembatalan dan tukar masa", "Tetapkan tempoh batal percuma bagi setiap aktiviti. Pelanggan boleh batal atau tukar masa tempahan sendiri dalam tempoh itu dan nampak hasilnya sebelum mengesahkan."],
      ["Penutupan", "Hujan atau penyelenggaraan? Tutup satu slot atau sehari penuh. Setiap pelanggan yang terlibat menerima satu e-mel untuk memilih bayaran balik atau masa baharu."],
      ["Makluman WhatsApp dan senarai harian", "Kaunter anda menerima mesej WhatsApp bagi setiap tempahan, pembatalan dan pertukaran masa, berserta pautan ke senarai tiket hari itu yang sentiasa terkini. Tanpa perlu log masuk."],
      ["Bahasa Malaysia dan Inggeris", "Halaman dan e-mel pelanggan dalam kedua-dua bahasa. Makluman staf dihantar dalam bahasa pilihan setiap penerima."],
    ],
    custom: ["Peraturan anda", "Dibina khas mengikut cara anda beroperasi.", "Setiap tempat berbeza cara kerjanya. Sebelum membina, kami catat peraturan anda dan tetapkan enjin mengikutnya."],
    customItems: [
      ["Peraturan tempahan", "Tempoh batal, had masa tempahan, berapa banyak tempahan seorang pelanggan boleh pegang, dan siapa boleh tempah apa."],
      ["Lokasi dan sumber", "Gelanggang, bilik, lorong dan jurulatih, masing-masing dengan waktu operasi dan hari tutup sendiri."],
      ["Harga", "Waktu puncak dan biasa, kadar hujung minggu dan cuti umum, pek sesi dan kategori tiket acara."],
      ["Jenama dan domain", "Laman anda sendiri di domain anda, dengan logo, warna dan kandungan dalam BM dan Bahasa Inggeris."],
      ["Pasukan dan peranan", "Akses berasingan untuk pemilik, staf kaunter dan admin."],
      ["Integrasi", "Sistem perakaunan, keahlian atau sistem sedia ada anda. Setiap satu diberi skop dan sebut harga."],
    ],
    packageSection: ["Pakej", "Satu Pakej, harganya ikut peraturan anda."],
    hostingTitle: "Hosting merangkumi",
    hostingFrom: `${hosting}. Dibayar setiap tahun mulai pelancaran.`,
    pricing: "Care plan dan Add-on service",
    proof: ["Bukti", "Lihat sendiri di komugo.com.", "Komugo Platform ialah pasaran tempahan aktiviti kami sendiri di Putrajaya. Ia sudah dilancarkan secara terhad dan dibina di atas enjin yang diterangkan di atas. Buka dan pilih satu gelanggang untuk lihat aliran yang pelanggan anda akan lalui."],
    visit: "Layari komugo.com",
    caseStudy: "Baca kajian kes",
    faqLabel: "Soalan",
    faqTitle: "Tentang Sistem tempahan.",
    faq: [
      ["Adakah ia dibina dari kosong?", `Tidak. Ia dibina khas mengikut peraturan anda di atas enjin tempahan kami yang telah terbukti, enjin yang menggerakkan Komugo Platform. Sebab itu ia siap dalam ${p.delivery.ms}, bukan setahun.`],
      ["Adakah kami dapat laman sendiri, atau sekadar penyenaraian di komugo.com?", "Laman anda sendiri di domain anda, dengan jenama dan papan pemuka admin anda sendiri. Ia bukan penyenaraian di komugo.com."],
      ["Apa yang menentukan harga akhir?", `Yuran pembangunan ialah ${fee}. ${p.priceNote!.ms}`],
      ["Boleh kami guna gerbang pembayaran selain CHIP?", "Enjin ini menerima bayaran dan menghantar bayaran balik melalui CHIP. Gerbang lain boleh digunakan; kami skopkannya sebagai integrasi dan ia diambil kira dalam sebut harga."],
      ["Apa yang termasuk dalam Hosting dan sokongan teknikal?", `${hostingSentence("ms")}. ${hosting}. ${careNote.ms}`],
      ["Untuk siapa sistem ini?", `${p.bestFor.ms.join(", ")}. Jika orang menempah masa, tempat atau tiket daripada anda, ia sesuai.`],
    ],
  },
}[locale];
const faq = copy.faq.map(([q, a]) => ({ q, a }));
---

<Base locale={locale} path="/booking-system" title={copy.title} description={copy.description} jsonLd={[packageLd(Astro.site, locale, p)]}>
  <section class="wrap pt-14 pb-16 md:pt-24 md:pb-24">
    <Breadcrumbs locale={locale} items={[{ name: copy.crumb, path: "/booking-system" }]} />
    <div class="rise">
      <h1 class="display mt-8 max-w-[14ch]">{copy.h1}</h1>
      <div class="grid-12 mt-12 gap-y-10 md:mt-20">
        <dl class="col-span-12 grid grid-cols-2 gap-x-6 gap-y-6 self-start md:col-span-4 md:grid-cols-1 lg:col-span-3">
          <div class="col-span-2 md:col-span-1">
            <dt class="text-sm text-muted">{copy.feeLabel}</dt>
            <dd class="num font-display mt-1 text-4xl font-medium tracking-tight">{fee}</dd>
          </div>
          <div>
            <dt class="text-sm text-muted">{copy.hostingLabel}</dt>
            <dd class="num mt-1 font-semibold">{hosting}</dd>
          </div>
          <div>
            <dt class="text-sm text-muted">{copy.deliveryLabel}</dt>
            <dd class="mt-1 font-semibold">{p.delivery[locale]}</dd>
          </div>
        </dl>
        <div class="col-span-12 md:col-span-8 lg:col-span-6 lg:col-start-4">
          <p class="lede">{copy.lede}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={quote} class="btn btn-primary">{s.choose(p.name[locale])}</a>
            <a href={company.platformUrl} class="btn btn-quiet" rel="noopener">{copy.live}</a>
          </div>
        </div>
      </div>
      <Shot class="mt-16 md:mt-24" src="/work/komugo-platform-activity.jpg" alt={copy.shotAlt} width={1600} height={1000} caption={copy.shotCaption} eager />
    </div>
  </section>

  <Section id="engine" label={copy.engine[0]} title={copy.engine[1]} intro={copy.engine[2]} wide>
    <ol class="grid gap-px border-y border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        copy.features.map(([name, body], i) => (
          <li class="bg-paper py-8 sm:px-6 lg:py-10">
            <p class="num text-sm text-forest">{String(i + 1).padStart(2, "0")}</p>
            <h3 class="mt-6 text-2xl">{name}</h3>
            <p class="mt-3 text-muted">{body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="custom" label={copy.custom[0]} title={copy.custom[1]} intro={copy.custom[2]}>
    <dl class="border-b border-line">
      {
        copy.customItems.map(([term, body]) => (
          <div class="grid gap-2 border-t border-line py-6 md:grid-cols-[14rem_1fr] md:gap-8">
            <dt class="font-display text-xl font-medium tracking-tight">{term}</dt>
            <dd class="text-muted">{body}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section id="package" label={copy.packageSection[0]} title={copy.packageSection[1]} wide>
    <div class="grid-12 gap-y-14">
      <div class="col-span-12 md:col-span-7">
        <PackageCard locale={locale} item={p} />
      </div>
      <aside class="col-span-12 md:col-span-4 md:col-start-9">
        <h3 class="border-t-2 border-ink pt-6 text-2xl">{copy.hostingTitle}</h3>
        <ul class="mt-6 space-y-2">
          {
            hostingCovers[locale].map((h) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="mt-[0.7em] h-px w-3 shrink-0 bg-forest" />
                {h}
              </li>
            ))
          }
        </ul>
        <p class="num mt-6 font-semibold">{copy.hostingFrom}</p>
        <p class="mt-3 text-sm text-muted">{careNote[locale]}</p>
        <a href={href(locale, "/pricing")} class="link mt-6 inline-flex min-h-11 items-center">{copy.pricing}</a>
      </aside>
    </div>
  </Section>

  <Section id="proof" label={copy.proof[0]} title={copy.proof[1]} intro={copy.proof[2]}>
    <div class="flex flex-wrap gap-3">
      <a href={company.platformUrl} class="btn btn-primary" rel="noopener">{copy.visit}</a>
      <a href={href(locale, "/work/komugo-platform")} class="btn btn-quiet">{copy.caseStudy}</a>
    </div>
  </Section>

  <Section id="faq" label={copy.faqLabel} title={copy.faqTitle}>
    <Faq items={faq} />
  </Section>

  <CtaBand locale={locale} packageId="booking" />
</Base>
