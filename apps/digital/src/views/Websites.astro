---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PackageCard from "../components/PackageCard.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { addonNote, addons } from "../content/addons";
import { carePlans } from "../content/care";
import { href, rm, t, type Locale } from "../content/i18n";
import { pkg, type PackageId } from "../content/packages";
import { packageLd } from "../lib/seo";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t[locale];
const ids: PackageId[] = ["starter", "business", "corporate"];
const items = ids.map(pkg);
const [starter, business, corporate] = items;
const translation = addons[3];
const webAddons = addons.slice(0, 5);

const copy = {
  en: {
    title: `Website design in Malaysia from ${rm("en", starter.fee)} | Komugo Digital`,
    description: `Website design and build for Malaysian businesses: a one-page Starter at ${rm("en", starter.fee)}, a 5-page Business site at ${rm("en", business.fee)}, a bilingual Corporate site at ${rm("en", corporate.fee)}.`,
    crumb: "Websites",
    h1: "Website design for Malaysian businesses.",
    lede: "Three Packages for three stages of a business. Each is designed for your brand, built to load fast on a phone, and launched with Hosting in place.",
    pick: "Which one fits",
    pickTitle: "Start from what the site has to do.",
    fits: [
      [starter, "One page that answers the first three questions: what you do, where you are, how to reach you. Visitors tap through to WhatsApp or the contact form."],
      [business, "A site that explains each service on its own page, gets found on Google, and that you can update yourself without calling us."],
      [corporate, "A full company presence in English and Bahasa Malaysia: divisions, announcements, careers and documents people can download."],
    ] as const,
    compare: "Compare",
    compareTitle: "Side by side.",
    rows: [
      ["Pages", "1", "Up to 5", "Up to 10–12"],
      ["Design", "Modern responsive", "Custom UI/UX", "Premium custom UI/UX"],
      ["Languages", "One", "One", "English and BM"],
      ["Editing", "Through us", "Basic CMS", "Advanced CMS"],
      ["SEO", "Basic setup", "On-page SEO", "Advanced SEO structure"],
      ["Analytics", "—", "Google Analytics and Search Console", "Google Analytics, Search Console and analytics dashboard"],
    ],
    fee: "Development fee",
    packagesLabel: "Packages",
    packagesTitle: "What each Package includes.",
    addonsLabel: "Add-on services",
    addonsTitle: "Need a little more?",
    addonsLink: "All Add-on services",
    faqLabel: "Questions",
    faqTitle: "About websites.",
    faq: [
      ["Can I update the website myself?", `On Business and Corporate, yes, through the CMS. On Starter, we make the edits, either through a Care plan from ${rm("en", carePlans[0].fee, true)} a month or quoted one by one.`],
      ["Do I need to prepare the text and photos?", `You know your business best, so you supply the content and we shape it into pages. If you'd rather not write it, copywriting is an Add-on service at ${rm("en", addons[2].fee)}.`],
      ["Can the site be in English and Bahasa Malaysia?", `Corporate includes both. For Starter or Business, add our ${translation.name.en} Add-on service for ${rm("en", translation.fee)}.`],
      ["What happens after launch?", "Your site runs on Hosting, paid yearly: servers, SSL, daily backups, monitoring, security patches and fixes to what we built. Content changes are separate, through a Care plan or the CMS."],
      ["Can I start with Starter and upgrade later?", "Yes. Tell us when you're ready and we'll quote the move to Business or Corporate based on what's already built."],
    ],
  },
  ms: {
    title: `Reka bentuk laman web di Malaysia dari ${rm("ms", starter.fee)}`,
    description: `Reka bentuk dan pembinaan laman web untuk perniagaan di Malaysia: Starter satu halaman ${rm("ms", starter.fee)}, Business 5 halaman ${rm("ms", business.fee)}, Corporate dwibahasa ${rm("ms", corporate.fee)}.`,
    crumb: "Laman web",
    h1: "Reka bentuk laman web untuk perniagaan di Malaysia.",
    lede: "Tiga Pakej untuk tiga peringkat perniagaan. Setiap satu direka mengikut jenama anda, dibina supaya laju dibuka di telefon, dan dilancarkan bersama Hosting.",
    pick: "Mana yang sesuai",
    pickTitle: "Mula dengan apa yang laman perlu buat.",
    fits: [
      [starter, "Satu halaman yang menjawab tiga soalan pertama: apa yang anda buat, di mana anda, dan cara menghubungi anda. Pelawat terus tekan ke WhatsApp atau borang hubungi."],
      [business, "Laman yang menerangkan setiap perkhidmatan di halaman sendiri, mudah dijumpai di Google, dan boleh anda kemas kini sendiri tanpa menghubungi kami."],
      [corporate, "Kehadiran syarikat yang lengkap dalam Bahasa Inggeris dan Bahasa Malaysia: bahagian, pengumuman, kerjaya dan dokumen untuk dimuat turun."],
    ] as const,
    compare: "Bandingkan",
    compareTitle: "Sebelah-menyebelah.",
    rows: [
      ["Halaman", "1", "Sehingga 5", "Sehingga 10–12"],
      ["Reka bentuk", "Moden dan responsif", "UI/UX khas", "UI/UX khas premium"],
      ["Bahasa", "Satu", "Satu", "Bahasa Inggeris dan BM"],
      ["Suntingan", "Melalui kami", "CMS asas", "CMS lanjutan"],
      ["SEO", "Persediaan asas", "SEO dalam halaman", "Struktur SEO lanjutan"],
      ["Analitik", "—", "Google Analytics dan Search Console", "Google Analytics, Search Console dan papan pemuka analitik"],
    ],
    fee: "Yuran pembangunan",
    packagesLabel: "Pakej",
    packagesTitle: "Apa yang termasuk dalam setiap Pakej.",
    addonsLabel: "Add-on service",
    addonsTitle: "Perlu sedikit lagi?",
    addonsLink: "Semua Add-on service",
    faqLabel: "Soalan",
    faqTitle: "Tentang laman web.",
    faq: [
      ["Boleh saya kemas kini laman web sendiri?", `Untuk Business dan Corporate, boleh, melalui CMS. Untuk Starter, kami yang buat suntingan, sama ada melalui Care plan dari ${rm("ms", carePlans[0].fee, true)} sebulan atau sebut harga satu per satu.`],
      ["Perlukah saya sediakan teks dan gambar?", `Anda paling kenal perniagaan anda, jadi anda bekalkan kandungan dan kami susun menjadi halaman. Jika tidak mahu menulis sendiri, penulisan kandungan ialah Add-on service pada harga ${rm("ms", addons[2].fee)}.`],
      ["Boleh laman dalam Bahasa Inggeris dan Bahasa Malaysia?", `Corporate sudah termasuk kedua-duanya. Untuk Starter atau Business, tambah Add-on service ${translation.name.ms} pada harga ${rm("ms", translation.fee)}.`],
      ["Apa berlaku selepas pelancaran?", "Laman anda berjalan dengan Hosting, dibayar setiap tahun: pelayan, SSL, sandaran harian, pemantauan, tampalan keselamatan dan pembaikan pada apa yang kami bina. Perubahan kandungan adalah berasingan, melalui Care plan atau CMS."],
      ["Boleh saya mula dengan Starter dan naik taraf kemudian?", "Boleh. Beritahu kami bila anda bersedia dan kami akan beri sebut harga untuk beralih ke Business atau Corporate berdasarkan apa yang sudah dibina."],
    ],
  },
}[locale];
const faq = copy.faq.map(([q, a]) => ({ q, a }));
---

<Base locale={locale} path="/websites" title={copy.title} description={copy.description} jsonLd={items.map((p) => packageLd(Astro.site, locale, p))}>
  <section class="wrap pt-14 pb-16 md:pt-24 md:pb-24">
    <Breadcrumbs locale={locale} items={[{ name: copy.crumb, path: "/websites" }]} />
    <div class="rise">
      <h1 class="display mt-8 max-w-[14ch]">{copy.h1}</h1>
      <div class="mt-10 md:mt-14 md:ml-[25%]">
        <p class="lede">{copy.lede}</p>
        <a href={href(locale, "/contact")} class="btn btn-primary mt-8">{s.getQuote}</a>
      </div>
    </div>
  </section>

  <Section id="fit" label={copy.pick} title={copy.pickTitle} wide>
    <ol class="border-b border-line">
      {
        copy.fits.map(([p, body]) => (
          <li class="grid gap-x-8 gap-y-3 border-t border-line py-8 md:grid-cols-12 md:py-10">
            <p class="num text-sm text-muted md:col-span-1">{p.no}</p>
            <div class="md:col-span-4">
              <h3 class="text-3xl">
                <a href={`#${p.id}`} class="hover:underline hover:decoration-1 hover:underline-offset-4">{p.name[locale]}</a>
              </h3>
              <p class="num mt-2 text-muted">{rm(locale, p.fee)} · {p.delivery[locale]}</p>
            </div>
            <div class="md:col-span-7">
              <p class="text-lg">{body}</p>
              <p class="mt-3 text-sm text-muted">{s.bestFor}: {p.bestFor[locale].join(", ")}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="compare" label={copy.compare} title={copy.compareTitle} wide>
    <div class="overflow-x-auto" tabindex="0" role="region" aria-label={copy.compareTitle}>
      <table class="w-full min-w-[36rem] border-b border-line text-left">
        <caption class="sr-only">{copy.compareTitle}</caption>
        <thead>
          <tr class="align-bottom">
            <td class="w-1/4"></td>
            {items.map((p) => <th scope="col" class="w-1/4 pb-4 font-display text-2xl font-medium tracking-tight">{p.name[locale]}</th>)}
          </tr>
        </thead>
        <tbody>
          <tr class="border-t border-ink">
            <th scope="row" class="py-4 pr-4 font-normal text-muted">{copy.fee}</th>
            {items.map((p) => <td class="num py-4 pr-4 font-semibold">{rm(locale, p.fee)}</td>)}
          </tr>
          <tr class="border-t border-line">
            <th scope="row" class="py-4 pr-4 font-normal text-muted">{s.hosting}</th>
            {items.map((p) => <td class="num py-4 pr-4">{`${rm(locale, p.hosting!)}${s.perYear}`}</td>)}
          </tr>
          <tr class="border-t border-line">
            <th scope="row" class="py-4 pr-4 font-normal text-muted">{s.delivery}</th>
            {items.map((p) => <td class="py-4 pr-4">{p.delivery[locale]}</td>)}
          </tr>
          {
            copy.rows.map(([label, ...cells]) => (
              <tr class="border-t border-line">
                <th scope="row" class="py-4 pr-4 font-normal text-muted">{label}</th>
                {cells.map((c) => <td class="py-4 pr-4">{c}</td>)}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Section>

  <Section id="packages" label={copy.packagesLabel} title={copy.packagesTitle} wide>
    <div class="grid gap-16 md:grid-cols-3 md:gap-8">
      {items.map((p) => <PackageCard locale={locale} item={p} />)}
    </div>
  </Section>

  <Section id="addons" label={copy.addonsLabel} title={copy.addonsTitle}>
    <ul class="border-b border-line">
      {
        webAddons.map((a) => (
          <li class="flex items-baseline justify-between gap-6 border-t border-line py-4">
            <span>{a.name[locale]}</span>
            <span class="num shrink-0 font-semibold">{rm(locale, a.fee)}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 max-w-2xl text-sm text-muted">{addonNote[locale]}</p>
    <a href={`${href(locale, "/pricing")}#addons`} class="link mt-6 inline-flex min-h-11 items-center">{copy.addonsLink}</a>
  </Section>

  <Section id="faq" label={copy.faqLabel} title={copy.faqTitle}>
    <Faq items={faq} />
  </Section>

  <CtaBand locale={locale} />
</Base>
