---
import JsonLd from "./JsonLd.astro";
import { faqLd } from "../lib/seo";

interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="border-b border-line">
  {
    items.map((f) => (
      <details class="group border-t border-line">
        <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-4 text-lg font-medium md:text-xl [&::-webkit-details-marker]:hidden">
          {f.q}
          <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 shrink-0 transition-transform group-open:rotate-45 motion-reduce:transition-none" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 2v12M2 8h12" /></svg>
        </summary>
        <p class="max-w-2xl pb-6 text-muted">{f.a}</p>
      </details>
    ))
  }
</div>
<JsonLd data={faqLd(items)} />
