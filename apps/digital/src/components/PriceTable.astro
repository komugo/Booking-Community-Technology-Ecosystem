---
import { href, rm, t, type Locale } from "../content/i18n";
import { packages, type PackageId } from "../content/packages";

interface Props {
  locale: Locale;
  ids?: PackageId[];
}
const { locale, ids } = Astro.props;
const s = t[locale];
const rows = ids ? packages.filter((p) => ids.includes(p.id)) : packages;
---

<ol class="border-b border-line">
  {
    rows.map((p) => (
      <li class="group relative grid grid-cols-[2.5rem_1fr] gap-x-4 gap-y-2 border-t border-line py-6 md:grid-cols-[3.5rem_1.2fr_1fr_auto] md:items-baseline md:gap-x-8 md:py-8">
        <span class="num text-sm text-muted md:text-base">{p.no}</span>
        <div>
          <h3 class="text-2xl md:text-3xl">
            <a href={`${href(locale, p.page)}#${p.id}`} class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">{p.name[locale]}</a>
          </h3>
          <p class="mt-1 text-muted">{p.title[locale]}</p>
        </div>
        <p class="col-start-2 text-sm text-muted md:col-start-auto md:text-base">{p.bestFor[locale].slice(0, 3).join(", ")}</p>
        <div class="col-start-2 flex items-baseline justify-between gap-4 md:col-start-auto md:justify-end md:text-right">
          <div>
            <p class="num font-display text-2xl font-medium tracking-tight whitespace-nowrap md:text-3xl">{rm(locale, p.fee)}</p>
            <p class="num text-sm text-muted">{p.hosting ? `+ ${s.hosting} ${rm(locale, p.hosting, true)}${s.perYear}` : s.quoted}</p>
          </div>
          <svg aria-hidden="true" viewBox="0 0 16 16" class="size-5 shrink-0 self-center text-forest transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none motion-reduce:transform-none" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </div>
      </li>
    ))
  }
</ol>
