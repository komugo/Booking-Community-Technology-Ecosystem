---
import { href, rm, t, type Locale } from "../content/i18n";
import { pkg, type Package } from "../content/packages";

interface Props {
  locale: Locale;
  item: Package;
  headingLevel?: "h2" | "h3";
  cta?: string;
}
const { locale, item: p, headingLevel = "h3", cta = `${href(locale, "/contact")}?package=${p.id}` } = Astro.props;
const s = t[locale];
const H = headingLevel;
---

<article id={p.id} class="flex scroll-mt-8 flex-col border-t-2 border-ink pt-6">
  <p class="num text-sm text-muted">{p.no}</p>
  <H class="mt-3 text-3xl md:text-4xl">{p.name[locale]}</H>
  <p class="mt-2 text-muted">{p.title[locale]}</p>
  <p class="num font-display mt-8 text-4xl font-medium tracking-tight">{rm(locale, p.fee)}</p>
  <p class="text-sm text-muted">{s.oneTime}</p>
  <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 border-y border-line py-5 text-sm">
    <div>
      <dt class="text-muted">{p.hostingNote && p.hosting ? p.hostingNote[locale] : s.hosting}</dt>
      <dd class="num mt-1 font-semibold">{p.hosting ? `${rm(locale, p.hosting)}${s.perYear}` : p.hostingNote?.[locale]}</dd>
    </div>
    <div>
      <dt class="text-muted">{s.delivery}</dt>
      <dd class="mt-1 font-semibold">{p.delivery[locale]}</dd>
    </div>
  </dl>
  <h4 class="mt-8 text-sm text-muted">{s.bestFor}</h4>
  <p class="mt-2">{p.bestFor[locale].join(", ")}</p>
  <h4 class="mt-8 text-sm text-muted">{p.extends ? s.everythingIn(pkg(p.extends).name[locale]) : s.includes}</h4>
  <ul class="mt-3 space-y-2">
    {
      p.includes[locale].map((i) => (
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-[0.7em] h-px w-3 shrink-0 bg-forest" />
          {i}
        </li>
      ))
    }
  </ul>
  {p.note && <p class="mt-8 text-sm text-muted">{p.note[locale]}{p.priceNote && ` ${p.priceNote[locale]}`}</p>}
  <div class="mt-auto pt-10">
    <a href={cta} class="btn btn-quiet">{s.choose(p.name[locale])}</a>
  </div>
</article>
