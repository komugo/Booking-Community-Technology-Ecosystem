---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
  eager?: boolean;
  class?: string;
}
const { src, alt, width, height, caption, eager = false, class: cls } = Astro.props;
---

<figure class={cls}>
  <div class="rounded-lg bg-sand p-3 sm:p-6 md:p-10">
    <img src={src} alt={alt} width={width} height={height} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined} decoding="async" class="h-auto w-full rounded-md shadow-[0_0_0_1px_var(--color-line)]" />
  </div>
  {caption && <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>}
</figure>
