{
  "name": "@komugo/digital",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4322",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "PUBLIC_SITE_URL=${PUBLIC_SITE_URL:-https://digital.komugo.com} astro build && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging PUBLIC_SITE_URL=https://komugo-digital-staging.komugo.workers.dev astro build && wrangler deploy",
    "typegen": "wrangler types --strict-vars=false",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@komugo/theme": "workspace:*",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.153.0"
  }
}
