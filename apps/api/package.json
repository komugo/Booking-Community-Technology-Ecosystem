{
  "name": "@komugo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types --strict-vars=false --include-runtime=false && wrangler types worker-runtime.d.ts --include-env=false",
    "db:migrate:local": "wrangler d1 migrations apply komugo --local",
    "db:migrate:remote": "wrangler d1 migrations apply komugo --remote",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@komugo/booking": "workspace:*",
    "@komugo/types": "workspace:*",
    "hono": "4.13.14"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  }
}
